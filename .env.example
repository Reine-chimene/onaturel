# O'Naturelle — copy to .env (never commit secrets)
# Host ports below avoid clashes with other local Docker projects.
# Inside Docker, API still talks to postgres:5432 and minio:9000.

POSTGRES_USER=onaturelle
POSTGRES_PASSWORD=onaturelle
POSTGRES_DB=onaturelle
POSTGRES_PORT=5435
DATABASE_URL=postgresql+psycopg://onaturelle:onaturelle@localhost:5435/onaturelle

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=onaturelle
MINIO_SECRET_KEY=onaturelle_minio
MINIO_BUCKET=onaturelle-media
MINIO_USE_SSL=false

OWNER_EMAIL=onqture@onaturelle.local
OWNER_PASSWORD=naturel2
OWNER_NAME=O'Naturelle

SELLER_EMAIL=vendeuse@onaturelle.local
SELLER_PASSWORD=change-me-seller
SELLER_NAME=Vendeuse Cameroun

API_CORS_ORIGINS=http://localhost:3000
API_HOST_PORT=8002
API_PUBLIC_URL=http://localhost:8002
WEB_PUBLIC_URL=http://localhost:3000
WEB_PORT=3000
# Vide = Route Handlers Next.js (same-origin). Repli FastAPI : http://localhost:8002
NEXT_PUBLIC_API_URL=
# Domaine public (canonical, Open Graph, sitemap). Laisser localhost en dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
