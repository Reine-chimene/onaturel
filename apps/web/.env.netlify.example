# Variables à copier dans Netlify → Site configuration → Environment variables
# (Ne jamais committer de vraies valeurs.)

# --- PostgreSQL (ex. Neon : https://neon.tech) ---
# Runtime (pooler, ex. port 5432 avec ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Migrations Prisma (connexion directe, sans pooler)
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Auth
AUTH_SECRET=longue-chaine-aleatoire
JWT_SECRET=longue-chaine-aleatoire
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Images — stockage S3 compatible (Cloudflare R2, Backblaze B2, MinIO hébergé…)
# Le disque local ne fonctionne pas sur Netlify.
STORAGE_DRIVER=minio
MINIO_ENDPOINT=xxx.r2.cloudflarestorage.com
MINIO_PUBLIC_ENDPOINT=media.votre-domaine.fr
MINIO_ACCESS_KEY=...
MINIO_SECRET_KEY=...
MINIO_BUCKET=onaturelle-media
MINIO_USE_SSL=true

# URL publique du site Netlify (sans slash final)
NEXT_PUBLIC_SITE_URL=https://votre-site.netlify.app

# Laisser vide : l’API tourne dans Next.js (same-origin)
NEXT_PUBLIC_API_URL=
