{
  "name": "onaturelle-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "build:o2switch": "BUILD_TARGET=o2switch prisma generate && BUILD_TARGET=o2switch next build && node scripts/prepare-o2switch.mjs",
    "start": "next start --port 3000",
    "start:production": "NODE_ENV=production node server.js",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:baseline": "prisma migrate resolve --applied 0001_baseline",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^6.16.0",
    "prisma": "^6.16.0",
    "jose": "^6.2.10",
    "minio": "^8.0.7",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
