# Copier vers .env.local — ne jamais y coller de secrets réels.

# PostgreSQL (URI Prisma, sans le suffixe SQLAlchemy +psycopg)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5435/onaturelle
# Même URL en local ; sur Neon, URL directe (sans pooler) pour les migrations
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5435/onaturelle

# JWT (même secret que l’API FastAPI pendant la coexistence)
AUTH_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Stockage images — MinIO en dev Docker, local sur O2Switch
# STORAGE_DRIVER=local
# STORAGE_LOCAL_PATH=./storage/media
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=onaturelle
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=onaturelle-media
MINIO_USE_SSL=false

# Site public (canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laisser vide pour utiliser les Route Handlers Next.js (same-origin).
# Pointer vers FastAPI uniquement en repli : http://localhost:8002
NEXT_PUBLIC_API_URL=
