# O2Switch — copier vers .env à la racine de l'application sur le serveur

NODE_ENV=production

# PostgreSQL (cPanel → PostgreSQL Databases)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/NOM_BASE

# Auth (générez une chaîne longue et aléatoire)
AUTH_SECRET=changez-moi-une-longue-chaine-aleatoire
JWT_SECRET=changez-moi-une-longue-chaine-aleatoire
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Stockage images sur disque (pas de MinIO sur hébergement mutualisé)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/media

# URL publique du site (avec https://)
NEXT_PUBLIC_SITE_URL=https://www.votre-domaine.fr

# Laisser vide : l'API tourne dans Next.js (same-origin)
NEXT_PUBLIC_API_URL=
